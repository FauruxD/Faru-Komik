# Local scraper works without Supabase credentials.
SCRAPER_DELAY_MS=1500
SCRAPER_USER_AGENT=KomikCatalogBot/0.1

# Fill these in .env.local before running import:supabase.
SUPABASE_URL=
# Server-side only: existing sb_secret_ key or legacy service_role key.
# Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=

# Public frontend configuration (safe to expose with RLS enabled).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloud worker only: store these in Vercel Production, never NEXT_PUBLIC_.
# CRON_SECRET must be a random value of at least 32 characters.
CRON_SECRET=
# Stop ingestion before exhausting the database storage allowance.
SCRAPER_DATABASE_LIMIT_MB=400
